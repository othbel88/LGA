DirectoryIndex index.html
Options -Indexes -MultiViews
ServerSignature Off

# --- HTTPS obligatoire (à activer une fois le certificat SSL actif sur OVH) ---
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|192\.168\.|10\.)
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Les adresses d'origine sans slash final restent valides
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# Fichiers cachés et sauvegardes inaccessibles
<FilesMatch "(^\.|\.(bak|sql|sqlite|csv|log|sh|md|ini|env|sample\.php)$|~$)">
  Require all denied
</FilesMatch>
<FilesMatch "^\.htaccess$">
  Require all denied
</FilesMatch>

AddType video/mp4 .mp4

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-17UxUKU1Fldc3uRdJ31PIUqc3EcWsPVA/ozeOilEptY=' 'sha256-26Jo3NFWRFmoSiA2/3sAoLqouyZkWoMcDGhSuYXOgYU=' 'sha256-7YEBr45JFe+c/3M0WS5NM8s1EvLNaZ8Qia5Otdg27oc=' 'sha256-DHVGXkFpDO07Gm7KHrrwtc7yuig6PhBp7MPNu2QQuhs=' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo=' 'sha256-GNPGjlEHniUoCYaR+L2DysHqe5IweNLdeSLL57T7VmU=' 'sha256-JJ7jUXQnRoe1PiTSw1f9SBD7DUh2QwB1OFQpt5r03GU=' 'sha256-M83XYzv5qrvd3X3JQJneIn9jN14XxQZvEuYlFzpsp+4=' 'sha256-PnUUc+PN4bx+WVxCgbs/MK6GzFODdV5uBQXwNFeBa3Q=' 'sha256-QIjotsDk9W5gX5JTr/emfCKZDoz6Nb1N2GLANZTTZLE=' 'sha256-Zfh/6DwjzOTpdCYKxFDLZmLS2oiYWNr3wYVmm5t4lnk=' 'sha256-f5v0S+RugC+TgGXQbuQsnAJm85O1R0xcG1lAaMxkVfo=' 'sha256-gpDSvUVvhWUMiU0SjPEJ1SMBQMoRNAs9w3z1DkV0dUM=' 'sha256-hLLJJjs15kXZO9BpQBRCcQw/NtQjfTx0MRmBa5L40v8=' 'sha256-hLklqaLkfT0cLv/OXiPmiXaJJMLrUe2/Wvs+QOG8cF8=' 'sha256-id/ovKN8SzbjZNenV8CPGn9n3NlORSXvMSo29Ihjt2I=' 'sha256-kOYAnMJFmvOyR+T64ZBwMGkhb0GCc/sw00rP/m4v+pE=' 'sha256-lpvUuBBOfWCfTSesX/jJ39fV264oSxkT3a6BwwEXk8c=' 'sha256-sUAX7dTq61jwketkVVbrjt1+JD8VZE8nWOmo7mIrecU=' 'sha256-yRWlEYRJy+OAbz70Zyboe2vsXzPPvnnM43Zw4VtAGdc=' https://www.jscache.com https://*.tacdn.com https://www.tripadvisor.com https://www.tripadvisor.fr https://www.tripadvisor.co.uk; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://awards.infcdn.net https://*.tacdn.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self'; frame-src 'self' https://maps.google.com https://www.google.com; connect-src 'self' https://www.jscache.com https://*.tripadvisor.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>
